Here is the equivalent implementation using TensorFlow and Keras.
TensorFlow makes features like Early Stopping and Learning Rate reduction much cleaner than PyTorch, as they are built directly into the framework as **Callbacks** that you just pass into the model.fit() function.
To track the R^2 score ("accuracy") during training so we can plot it, I have also included a custom Keras metric function (r2_metric).
### TensorFlow / Keras Implementation
```python
import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt

# ---------------------------------------------------------
# 1. Create and Shuffle Synthetic Polynomial Data
# ---------------------------------------------------------
np.random.seed(42)
tf.random.set_seed(42)

# Generate 500 data points (underlying curve: y = x^3 - 2x^2 + x)
x_data = np.linspace(-3, 3, 500).reshape(-1, 1)
y_data = x_data**3 - 2 * x_data**2 + x_data + np.random.randn(500, 1) * 2

# Shuffle the data BEFORE splitting
indices = np.arange(len(x_data))
np.random.shuffle(indices)
x_data = x_data[indices]
y_data = y_data[indices]

# ---------------------------------------------------------
# 2. Train, Validation, and Test Split
# ---------------------------------------------------------
# 70% Train, 15% Validation, 15% Test
train_split = int(0.7 * len(x_data))
val_split = int(0.85 * len(x_data))

x_train, y_train = x_data[:train_split], y_data[:train_split]
x_val, y_val = x_data[train_split:val_split], y_data[train_split:val_split]
x_test, y_test = x_data[val_split:], y_data[val_split:]

# ---------------------------------------------------------
# 3. Define the DNN Model & Custom Metric
# ---------------------------------------------------------
# Keras doesn't have a built-in R2 metric, so we define one to track "accuracy"
def r2_metric(y_true, y_pred):
    SS_res = tf.reduce_sum(tf.square(y_true - y_pred))
    SS_tot = tf.reduce_sum(tf.square(y_true - tf.reduce_mean(y_true)))
    return (1 - SS_res / (SS_tot + tf.keras.backend.epsilon()))

model = tf.keras.Sequential([
    tf.keras.layers.Dense(32, activation='relu', input_shape=(1,)),
    tf.keras.layers.Dense(64, activation='relu'),
    tf.keras.layers.Dense(32, activation='relu'),
    tf.keras.layers.Dense(1) # Output layer for regression
])

# ---------------------------------------------------------
# 4. Optimizer, Callbacks (Early Stop & Reduce LR)
# ---------------------------------------------------------
model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.01),
    loss='mse',
    metrics=[r2_metric]
)

# Stop training if validation loss doesn't improve for 150 epochs
early_stop = tf.keras.callbacks.EarlyStopping(
    monitor='val_loss', 
    patience=150, 
    restore_best_weights=True, # Automatically restores best model at the end
    verbose=1
)

# Halve the learning rate if validation loss plateaus for 50 epochs
reduce_lr = tf.keras.callbacks.ReduceLROnPlateau(
    monitor='val_loss', 
    factor=0.5, 
    patience=50, 
    min_lr=1e-6,
    verbose=1
)

# ---------------------------------------------------------
# 5. Training Loop
# ---------------------------------------------------------
epochs = 2000

# history object stores all the metrics for plotting later
history = model.fit(
    x_train, y_train,
    validation_data=(x_val, y_val),
    epochs=epochs,
    callbacks=[early_stop, reduce_lr],
    verbose=0 # Set to 1 if you want to see the progress bar per epoch
)

# ---------------------------------------------------------
# 6. Evaluate on Test Set
# ---------------------------------------------------------
test_loss, test_r2 = model.evaluate(x_test, y_test, verbose=0)

print("-" * 50)
print(f"TEST SET RESULTS:")
print(f"Test Loss (MSE): {test_loss:.4f}")
print(f"Test 'Accuracy' (R2 Score): {test_r2:.4f}")
print("-" * 50)

# ---------------------------------------------------------
# 7. Predict for a Custom Value
# ---------------------------------------------------------
custom_value = 2.5
# Keras expects 2D inputs for prediction: shape (batch_size, features)
custom_prediction = model.predict(np.array([[custom_value]]), verbose=0)[0][0]

# The true mathematical value without noise for x=2.5
true_value_no_noise = (custom_value**3) - 2*(custom_value**2) + custom_value

print(f"CUSTOM PREDICTION:")
print(f"Input X = {custom_value}")
print(f"Model Predicted Y = {custom_prediction:.4f}")
print(f"True Math Y (without noise) = {true_value_no_noise:.4f}")
print("-" * 50)

# ---------------------------------------------------------
# 8. Plot Metrics
# ---------------------------------------------------------
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))

# Plot 1: Train vs Validation Loss
ax1.plot(history.history['loss'], label='Train Loss', color='blue')
ax1.plot(history.history['val_loss'], label='Validation Loss', color='red')
ax1.set_title('Training vs Validation Loss (MSE)')
ax1.set_xlabel('Epochs')
ax1.set_ylabel('Loss')
ax1.legend()
ax1.grid(True)

# Plot 2: Train vs Validation Accuracy (R2 Score)
ax2.plot(history.history['r2_metric'], label='Train R2 (Accuracy)', color='blue')
ax2.plot(history.history['val_r2_metric'], label='Validation R2 (Accuracy)', color='red')
ax2.set_title('Training vs Validation "Accuracy" (R² Score)')
ax2.set_xlabel('Epochs')
ax2.set_ylabel('R² Score')
ax2.legend()
ax2.grid(True)

plt.tight_layout()
plt.show()

```
